#!/usr/bin/env bash
# Installs nginx and configures a 301 redirection from /redirect_me to another page
apt-get update -y
apt-get install -y nginx
echo "Holberton School for the win!" > /var/www/html/index.html
if ! grep -q "redirect_me" /etc/nginx/sites-enabled/default
then
  sed -i "s#server_name _;#server_name _;\n\n\tlocation /redirect_me {\n\t\treturn 301 https://www.youtube.com/watch?v=QH2-TGUlwu4;\n\t}#" /etc/nginx/sites-enabled/default
fi
service nginx restart
